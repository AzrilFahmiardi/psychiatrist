APP_NAME=Sikolov
APP_ENV=production
# Generate: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://sikolov.com

# Docker: port host yang dibuka ke container app (arahkan reverse proxy ke sini)
APP_BIND=127.0.0.1
APP_PORT=8013
# Jalankan `php artisan migrate --force` otomatis setiap container app start
RUN_MIGRATIONS=false
# IP/CIDR reverse proxy yang dipercaya (pisah koma), atau * kalau app cuma bisa diakses lewat proxy
TRUSTED_PROXIES=*

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Di Docker, DB_CONNECTION/DB_HOST/DB_PORT di-override docker-compose.yml (mysql, db, 3306)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sikolov
# Jangan pakai "root" (user ini dibuat otomatis oleh container MySQL)
DB_USERNAME=sikolov
DB_PASSWORD=
# Password root MySQL (dipakai container db)
DB_ROOT_PASSWORD=

# Google OAuth (login Google + Google Calendar)
CLIENT_ID=
CLIENT_SECRET=
CALLBACK_REDIRECT="${APP_URL}/auth/google-callback"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
